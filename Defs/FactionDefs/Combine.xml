<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FactionDef ParentName="FactionBase">
		<defName>CGF1_HLRW_Faction_Combine</defName>
		<label>The Combine</label>
		<description>Also known by humans as the "Combine," the Universal Union is a mysterious and powerful multi-dimensional empire that seeks to conquer every world it comes across. The exact cause of their intrusion into human space is unknown, but they have established an extensive presence on even minor rim worlds such as this one.</description>
		<categoryTag>CGF1_HLRW_Faction_Combine</categoryTag>
		<fixedName>Universal Union</fixedName>
		<pawnSingular>Combine</pawnSingular>
		<pawnsPlural>Combine</pawnsPlural>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<maxCountAtGameStart>1</maxCountAtGameStart>
		<listOrderPriority>1</listOrderPriority>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<autoFlee>false</autoFlee>
		<earliestRaidDays>60</earliestRaidDays>
		<naturalEnemy>true</naturalEnemy>
		<leaderTitle>administrator</leaderTitle>
		<factionIconPath>CGF1/World/Combine</factionIconPath>
		<settlementNameMaker>CGF1_HLRW_Namer_Combine_Settlement</settlementNameMaker>
		<allowedCultures><li>CGF1_HLRW_Culture_Combine</li></allowedCultures>
