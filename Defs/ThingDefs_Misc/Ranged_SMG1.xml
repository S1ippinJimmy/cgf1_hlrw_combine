<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>CGF1_HLRW_Combine_SMG1_</defName>
		<label>Combine SMG1</label>
		<description>One of two SMGs issued to the transhuman arm of the Combine Overwatch, based on a pre-war human PDW design. Features an integrated small-caliber grenade launcher.</description>
		<techLevel>Industrial</techLevel>
		<graphicData>
			<texPath>CGF1/Gun/Combine_SMG1</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.98</drawSize>
		</graphicData>
		<soundInteract>CGF1_MWP_SFX_HLRW_Combine_SMG_Reload</soundInteract>
		<statBases>
			<WorkToMake>40000</WorkToMake>
			<Mass>2.4</Mass>
			<AccuracyTouch>0.85</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.20</AccuracyLong>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
		</statBases>
		<recipeMaker>
			<researchPrerequisite>GasOperation</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
			<displayPriority>200</displayPriority>
		</recipeMaker>
		<costList>
			<Steel>70</Steel>
			<ComponentIndustrial>6</ComponentIndustrial>
		</costList>
		<tradeTags>
			<li>CGF1_HLRW_Combine_Guns</li>
		</tradeTags>
		<weaponTags Inherit="False">
			<li>CGF1_HLRW_Combine_SMG</li>
		</weaponTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_HLRW_Bullet_Combine_SMG</defaultProjectile>
				<warmupTime>0.6</warmupTime>
				<range>24.9</range>
				<burstShotCount>6</burstShotCount>
				<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_HLRW_Combine_SMG</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<label>SMG1</label>
				<commandIcon>CGF1/Gun/Combine_SMG1</commandIcon>
			</li>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_Combine_SMG_Grenade</defaultProjectile>
				<warmupTime>3</warmupTime>
				<range>20.9</range>
				<forcedMissRadius>1.9</forcedMissRadius>
				<burstShotCount>1</burstShotCount>
				<soundCast>CGF1_MWP_SFX_HLRW_Combine_SMG1_Grenade</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>2</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<onlyManualCast>true</onlyManualCast>
				<label>SMG Grenade</label>
				<commandIcon>CGF1/Underbarrel/Combine_SMG1_Grenade</commandIcon>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.7,0.7)</drawSize>
				<offsets>
					<li>(0.31,0.09)</li>
				</offsets>
			</li>
		</modExtensions>
		<comps>
			<li Class="MVCF.Comps.CompProperties_VerbProps">
				<compClass>MVCF.Comps.Comp_VerbProps</compClass>
				<verbProps>
					<li>
						<label>SMG1</label>
						<canBeToggled>true</canBeToggled>
						<separateToggle>false</separateToggle>
					</li>
					<li>
						<label>SMG Grenade</label>
						<canBeToggled>true</canBeToggled>
						<separateToggle>false</separateToggle>
						<description>Launch a grenade from the second barrel of the SMG.</description>
					</li>
				</verbProps>
			</li>
		</comps>
		<thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
		<generateCommonality>1.5</generateCommonality> <!-- Everywhere -->
	</ThingDef>
	
</Defs>