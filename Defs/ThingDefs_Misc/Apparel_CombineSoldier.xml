<Defs>

	<!-- Combine Soldier -->

	<ThingDef ParentName="CGF1_HLRW_Combine_Apparel_Base" Name="CGF1_HLRW_Combine_Apparel_Soldier_Helmet">
		<defName>CGF1_HLRW_Combine_Apparel_Soldier_Helmet</defName>
		<label>combine soldier helmet</label>
		<description>A standard issue Combine Soldier helmet. Automatically biocodes upon being worn.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
		  <texPath>CGF1/Apparel/Combine/Soldier/Soldier_Helmet</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconScale>1.25</uiIconScale>
		<statBases>
			<WorkToMake>10000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>2</Mass>
			<Flammability>0.3</Flammability>
			<ArmorRating_Sharp>0.80</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.40</ArmorRating_Blunt>
			<ArmorRating_Heat>0.46</ArmorRating_Heat>
			<Insulation_Cold>4</Insulation_Cold>
			<Insulation_Heat>2</Insulation_Heat>
			<EquipDelay>3</EquipDelay>
		</statBases>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>CGF1_HLRW_Research_BasicCombineArmor</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
		<equippedStatOffsets>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.1</SlaveSuppressionOffset>
			<ToxicEnvironmentResistance>0.67</ToxicEnvironmentResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.67</VacuumResistance>
		</equippedStatOffsets>
		<costList>
			<Synthread>20</Synthread>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<apparel>
		  <countsAsClothingForNudity>false</countsAsClothingForNudity>
		  <bodyPartGroups>
			<li>FullHead</li>
		  </bodyPartGroups>
		  <wornGraphicPath>CGF1/Apparel/Combine/Soldier/Soldier_Helmet</wornGraphicPath>
		  <layers>
			<li>Overhead</li>
		  </layers>
		  <tags Inherit="False">
			<li>CGF1_HLRW_CombineApparel</li>
		  </tags>
		  <defaultOutfitTags>
			<li>Soldier</li>
			<li>Spacefarer</li>
		  </defaultOutfitTags>
		</apparel>
		<tradeTags Inherit="False">
			<li>CGF1_HLRW_Combine_Armor</li>
		</tradeTags>
		<thingCategories>
			<li>ArmorHeadgear</li>
		</thingCategories>
	</ThingDef>
	
