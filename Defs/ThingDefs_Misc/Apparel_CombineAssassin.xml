<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<!-- Combine Assassin -->

	<ThingDef ParentName="CGF1_HLRW_Combine_Apparel_Base">
		<defName>CGF1_HLRW_Combine_Apparel_Assassin_Helmet</defName>
		<label>combine assassin helmet</label>
		<description>A standard issue Combine Assassin helmet. The helmet has a built-in rangefinder and neural aiming array which boosts the shooting accuracy of the wearer. Automatically biocodes upon being worn.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
		  <texPath>CGF1/Apparel/Combine/Assassin/Assassin_Helmet</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconScale>1.25</uiIconScale>
		<statBases>
			<WorkToMake>20000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>2</Mass>
			<Flammability>0.3</Flammability>
			<ArmorRating_Sharp>0.85</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.42</ArmorRating_Blunt>
			<ArmorRating_Heat>0.48</ArmorRating_Heat>
			<Insulation_Cold>5</Insulation_Cold>
			<Insulation_Heat>3</Insulation_Heat>
			<EquipDelay>3</EquipDelay>
		</statBases>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>CGF1_HLRW_Research_AdvancedCombineArmor</researchPrerequisite>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
		<equippedStatOffsets>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.1</SlaveSuppressionOffset>
			<ToxicEnvironmentResistance>0.67</ToxicEnvironmentResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.67</VacuumResistance>
			<ShootingAccuracyPawn>2</ShootingAccuracyPawn>
		</equippedStatOffsets>
		<costList>
			<Synthread>50</Synthread>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<apparel>
		  <countsAsClothingForNudity>false</countsAsClothingForNudity>
		  <bodyPartGroups>
			<li>FullHead</li>
		  </bodyPartGroups>
		  <wornGraphicPath>CGF1/Apparel/Combine/Assassin/Assassin_Helmet</wornGraphicPath>
		  <layers>
			<li>Overhead</li>
		  </layers>
		  <tags Inherit="False">
			<li>CGF1_HLRW_CombineApparel</li>
		  </tags>
		  <defaultOutfitTags>
			<li>Soldier</li>
		  </defaultOutfitTags>
		</apparel>
		<tradeTags Inherit="False">
			<li>CGF1_HLRW_Combine_Armor</li>
		</tradeTags>
		<thingCategories>
			<li>ArmorHeadgear</li>
		</thingCategories>
	</ThingDef>
	
	<ThingDef ParentName="CGF1_HLRW_Combine_Apparel_Base">
		<defName>CGF1_HLRW_Combine_Apparel_Assassin_Armor</defName>
		<label>combine assassin armor</label>
		<description>A standard issue Combine Assassin suit of armor. While not as protective as most other forms of Combine armor, the suit sheds a significant amount of weight to increase mobility and flexibility. Automatically biocodes upon being worn.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
		  <texPath>CGF1/Apparel/Combine/Assassin/Assassin</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<WorkToMake>80000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>8</Mass>
			<Flammability>0.3</Flammability>
			<ArmorRating_Sharp>0.90</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.36</ArmorRating_Blunt>
			<ArmorRating_Heat>0.46</ArmorRating_Heat>
			<Insulation_Cold>35</Insulation_Cold>
			<Insulation_Heat>10</Insulation_Heat>
			<EquipDelay>14</EquipDelay>
		</statBases>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>CGF1_HLRW_Research_AdvancedCombineArmor</researchPrerequisite>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
