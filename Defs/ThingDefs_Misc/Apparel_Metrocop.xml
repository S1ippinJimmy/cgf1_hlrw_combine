<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- Combine Metrocop -->

	<ThingDef ParentName="CGF1_HLRW_Combine_Apparel_Base">
		<defName>CGF1_HLRW_Combine_Apparel_Metrocop_Helmet</defName>
		<label>metrocop helmet</label>
		<description>A standard Civil Protection-issue Metrocop helmet.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
		  <texPath>CGF1/Apparel/Combine/Metrocop/Metrocop_Helm</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconScale>1.25</uiIconScale>
		<statBases>
			<WorkToMake>5000</WorkToMake>
			<MaxHitPoints>350</MaxHitPoints>
			<Mass>2</Mass>
			<Flammability>0.3</Flammability>
			<ArmorRating_Sharp>0.60</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.40</ArmorRating_Blunt>
			<ArmorRating_Heat>0.46</ArmorRating_Heat>
			<Insulation_Cold>4</Insulation_Cold>
			<Insulation_Heat>2</Insulation_Heat>
			<EquipDelay>3</EquipDelay>
		</statBases>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>CGF1_HLRW_Research_BasicCombineArmor</researchPrerequisite>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
		<equippedStatOffsets>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.1</SlaveSuppressionOffset>
			<ToxicEnvironmentResistance>0.5</ToxicEnvironmentResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.2</VacuumResistance>
		</equippedStatOffsets>
		<costList>
			<Synthread>20</Synthread>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<apparel>
		  <countsAsClothingForNudity>false</countsAsClothingForNudity>
		  <bodyPartGroups>
			<li>FullHead</li>
		  </bodyPartGroups>
		  <wornGraphicPath>CGF1/Apparel/Combine/Metrocop/Metrocop_Helm</wornGraphicPath>
		  <layers>
			<li>Overhead</li>
		  </layers>
		  <tags Inherit="False">
			<li>CGF1_HLRW_CombineApparel</li>
		  </tags>
		  <defaultOutfitTags>
			<li>Soldier</li>
		  </defaultOutfitTags>
		</apparel>
		<tradeTags Inherit="False">
			<li>CGF1_HLRW_Combine_Armor</li>
		</tradeTags>
		<thingCategories>
			<li>ArmorHeadgear</li>
		</thingCategories>
		<comps>
			<li Class="CompProperties_Biocodable">
				<biocodeOnEquip>False</biocodeOnEquip>
			</li>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="CGF1_HLRW_Combine_Apparel_Base">
		<defName>CGF1_HLRW_Combine_Apparel_Metrocop_Armor</defName>
		<label>metrocop armor</label>
		<description>A standard issue Combine Metrocop suit of armor.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
		  <texPath>CGF1/Apparel/Combine/Metrocop/Metrocop</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<WorkToMake>9000</WorkToMake>
			<MaxHitPoints>300</MaxHitPoints>
			<Mass>10</Mass>
			<Flammability>0.3</Flammability>
			<ArmorRating_Sharp>0.87</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.28</ArmorRating_Blunt>
			<ArmorRating_Heat>0.36</ArmorRating_Heat>
			<Insulation_Cold>30</Insulation_Cold>
			<Insulation_Heat>10</Insulation_Heat>
			<EquipDelay>8</EquipDelay>
		</statBases>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisite>CGF1_HLRW_Research_BasicCombineArmor</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
		<equippedStatOffsets>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.1</SlaveSuppressionOffset>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.1</VacuumResistance>
		</equippedStatOffsets>
		<costList>
			<Synthread>60</Synthread>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<apparel>
		  <countsAsClothingForNudity>true</countsAsClothingForNudity>
		  <bodyPartGroups>
			<li>Neck</li>
			<li>Torso</li>
			<li>Shoulders</li>
			<li>Arms</li>
			<li>Legs</li>
		  </bodyPartGroups>
		  <wornGraphicPath>CGF1/Apparel/Combine/Metrocop/Metrocop</wornGraphicPath>
		  <layers>
			<li>Middle</li>
			<li>Shell</li>
		  </layers>
		  <tags Inherit="False">
			<li>CGF1_HLRW_CombineApparel</li>
		  </tags>
		  <defaultOutfitTags>
			<li>Soldier</li>
		  </defaultOutfitTags>
		  <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
          <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
          <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
		</apparel>
		<tradeTags Inherit="False">
			<li>CGF1_HLRW_Combine_Armor</li>
		</tradeTags>
		<thingCategories>
		  <li>ApparelArmor</li>
		</thingCategories>
		<comps>
			<li Class="CompProperties_Biocodable">
				<biocodeOnEquip>False</biocodeOnEquip>
			</li>
		</comps>
	</ThingDef>
	
</Defs>