<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>CGF1_HLRW_Combine_Suppressor_</defName>
		<label>Combine Suppressor</label>
		<description>A heavy Combine-issue pulse-charged machine gun that fires in extremely long and powerful bursts.</description>
		<techLevel>Ultra</techLevel>
		<graphicData>
			<texPath>CGF1/Gun/Combine_Suppressor</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.22</drawSize>
		</graphicData>
		<soundInteract>CGF1_MWP_SFX_HLRW_Combine_AR2_Reload</soundInteract>
		<statBases>
			<WorkToMake>100000</WorkToMake>
			<Mass>12</Mass>
			<AccuracyTouch>0.20</AccuracyTouch>
			<AccuracyShort>0.30</AccuracyShort>
			<AccuracyMedium>0.30</AccuracyMedium>
			<AccuracyLong>0.18</AccuracyLong>
			<RangedWeapon_Cooldown>2.8</RangedWeapon_Cooldown>
		</statBases>
		<recipeMaker>
			<researchPrerequisite>CGF1_HLRW_Research_PulseClassMunitions</researchPrerequisite>
			<skillRequirements>
				<Crafting>10</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
			<displayPriority>200</displayPriority>
		</recipeMaker>
		<costList>
			<CGF1_HLRW_Combine_Alloy>175</CGF1_HLRW_Combine_Alloy>
			<CGF1_HLRW_Combine_DarkEnergyOrb>2</CGF1_HLRW_Combine_DarkEnergyOrb>
		</costList>
		<equippedAngleOffset>40</equippedAngleOffset>
		<tradeTags>
			<li>CGF1_HLRW_Combine_Guns</li>
		</tradeTags>
		<weaponTags Inherit="False">
			<li>CGF1_HLRW_Combine_Heavy_MG</li>
		</weaponTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_HLRW_Bullet_PulseRound_AROne</defaultProjectile>
				<warmupTime>1.5</warmupTime>
				<range>31.9</range>
				<burstShotCount>36</burstShotCount>
				<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
				<soundAiming>CGF1_MWP_SFX_HLRW_Combine_Suppressor_Warmup</soundAiming>
				<soundCast>CGF1_MWP_SFX_HLRW_Combine_Suppressor</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_ChargedMuzzleFalsh</def>
				<drawSize>(1.0,1.0)</drawSize>
				<offsets>
					<li>(0.6,0.05)</li>
				</offsets>
			</li>
		</modExtensions>
		<thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
	</ThingDef>
	
</Defs>