<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<CultureDef>
		<defName>CGF1_HLRW_Culture_Combine</defName>
		<label>Universal Union</label>
		<description>Welcome, welcome to City 17.</description>
		<ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">CGF1_HLRW_NamerIdeo_Combine</ideoNameMaker>
		<deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">CGF1_HLRW_NamerDeity_Combine</deityNameMaker>
		<deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DeityTypeMakerKriminul</deityTypeMaker>
		<leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">CGF1_HLRW_LeaderTitleMaker_Combine</leaderTitleMaker>
		<festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalKriminul</festivalNameMaker>
		<allowedPlaceTags>
			<li MayRequire="Ludeon.RimWorld.Ideology">OriginSpacer</li>
		</allowedPlaceTags>
		<iconPath>CGF1/World/Combine</iconPath>
		<thingStyleCategories>
			<li MayRequire="Ludeon.RimWorld.Ideology">
				<category>Spikecore</category>
				<priority>2</priority>
			</li>
		</thingStyleCategories>
		<styleItemTags>
			<li>
				<tag>Rural</tag>
				<baseWeight>1</baseWeight>
				<weightFactor>1</weightFactor>
			</li>
			<li>
				<tag>NoBeard</tag>
				<baseWeight>10</baseWeight>
				<weightFactor>1</weightFactor>
			</li>
			<li>
				<tag>NoTattoo</tag>
				<baseWeight>1</baseWeight>
				<weightFactor>1</weightFactor>
			</li>
		</styleItemTags>
	</CultureDef>

	<RulePackDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>CGF1_HLRW_NamerIdeo_Combine</defName>
		<include>
			<li>GlobalUtility</li>
		</include>
		<rulePack>
			<rulesStrings>

				<!-- The Buzzwords -->
				<li>r_ideoName->[CombineAdjective] Dimension</li>
				<li>r_ideoName->[CombineAdjective] Society</li>
			
				<!-- Membername -->
				<li>r_memberName->combine</li>
			
				<li>r_ideoAdjective(priority=1)->Combine</li>
				<li>r_ideoAdjective(priority=1)->Transhuman</li>
			
				<!-- GK Creeds whatever the hell, Ideology DLC is annoying to deal with. -->
				<li>creed->[genericCreed]</li>

				<li>genericCreed->doctrine</li>
				<li>genericCreed->way</li>
				<li>genericCreed->path</li>
			
				<!-- The Whateverwords -->

				<li>CombineAdjective->Universal</li>
				<li>CombineAdjective->United</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>
	
	<RulePackDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>CGF1_HLRW_LeaderTitleMaker_Combine</defName>
		<rulePack>
			<rulesStrings>
				<li>r_leaderTitle->administrator</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>
	
	<RulePackDef>
		<defName>CGF1_HLRW_NamerDeity_Combine</defName>
		<include>
			<li MayRequire="Ludeon.RimWorld.Ideology">GlobalUtility</li>
		</include>
		<rulePack>
			<rulesStrings>
				<li>r_deityName->The Overseer</li>
				<li>r_deityName->The Watcher</li>
				<li>r_deityName->The Administrator</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>
</Defs>
